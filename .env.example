# Choose groq, openai or local. The app uses local fallback when no valid key is supplied.
AI_PROVIDER=local

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OUTPUT_DIR=

# Leave blank when exactly one matching file is copied into data/ and models/.
DATA_FILE=
MODEL_FILE=

# SMTP — used to email temporary passwords on user creation / password reset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
